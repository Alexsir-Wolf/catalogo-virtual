@page "/painel/entrar"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<OwnerAccount> SignInManager
@inject NavigationManager Navigation

<PageTitle>Acesso ao Painel</PageTitle>

<div class="acesso-fundo">
<div class="acesso">
    <aside class="acesso__marca">
        <div class="acesso__selo">CT</div>

        <h2>Painel do Catálogo</h2>

        <p>
            Onde o acervo é mantido e os catálogos em PDF são gerados.
            A vitrine pública não exige acesso — este painel sim.
        </p>

        <div class="acesso__passos">
            <div class="acesso__passo">
                <b>1</b><span>Cadastre produtos e defina a ordem de exibição</span>
            </div>
            <div class="acesso__passo">
                <b>2</b><span>Monte catálogos escolhendo categorias</span>
            </div>
            <div class="acesso__passo">
                <b>3</b><span>Gere o PDF e envie do seu jeito</span>
            </div>
        </div>
    </aside>

    <div class="acesso__lado">
        @* Estado UI-03.enviando. A tela é estática por decisão (ADR-010): torná-la
           interativa abriria circuito persistente para visitante anônimo na única rota
           anônima do painel. O estado é resolvido no cliente, sem cadeia de build e sem
           arquivo de script — a exceção à ADR-001 é esta, e cabe em poucas linhas.
           Sem ele, um duplo clique gasta duas das tentativas do bloqueio (RN-60). *@
        <EditForm Model="Input" FormName="acesso" OnValidSubmit="AuthenticateAsync" method="post"
                  class="acesso__form" data-estado-enviando="acesso">
            <DataAnnotationsValidator />

            <div>
                <h1>Entrar no painel</h1>
                <div class="acesso__sub">Acesso restrito ao responsável pelo catálogo.</div>
            </div>

            @if (lockedOutMinutes is not null)
            {
                <div class="acesso__alerta acesso__alerta--bloqueio" role="alert" data-estado="bloqueado">
                    <span class="acesso__alerta-i">!</span>
                    <span>
                        <b>Acesso bloqueado temporariamente</b> após várias tentativas sem
                        sucesso. Tente de novo em <b class="acesso__mono">@lockedOutMinutes min</b>.
                    </span>
                </div>
            }
            else if (failed)
            {
                <div class="acesso__alerta acesso__alerta--erro" role="alert" data-estado="erroCredencial">
                    <span class="acesso__alerta-i">!</span>
                    <span><b>Usuário ou senha incorretos.</b> Confira os dados e tente novamente.</span>
                </div>
            }

            <div class="acesso__campo @(failed ? "acesso__campo--erro" : null)">
                <label class="acesso__rotulo" for="usuario">Usuário</label>
                <InputText id="usuario" @bind-Value="Input.UserName" placeholder="seu usuário"
                           autocomplete="username" disabled="@isLockedOut" />
            </div>

            <div class="acesso__campo @(failed ? "acesso__campo--erro" : null)">
                <label class="acesso__rotulo" for="senha">Senha</label>

                <div class="acesso__senha">
                    <InputText id="senha" type="password" @bind-Value="Input.Password" placeholder="sua senha"
                               autocomplete="current-password" disabled="@isLockedOut" />

                    <button type="button" class="acesso__olho" data-ver-senha="senha"
                            aria-controls="senha" aria-pressed="false" aria-label="Mostrar senha"
                            disabled="@isLockedOut">
                        <svg class="acesso__olho-mostrar" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M1.8 12S5.4 5.2 12 5.2 22.2 12 22.2 12 18.6 18.8 12 18.8 1.8 12 1.8 12Z" />
                            <circle cx="12" cy="12" r="3.2" />
                        </svg>
                        <svg class="acesso__olho-ocultar" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M1.8 12S5.4 5.2 12 5.2c1.5 0 2.9.35 4.1.9M22.2 12s-3.6 6.8-10.2 6.8c-1.6 0-3-.4-4.3-1" />
                            <path d="M9.9 9.9a3.2 3.2 0 0 0 4.3 4.3" />
                            <path d="M3.5 3.5l17 17" />
                        </svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="acesso__entrar" disabled="@isLockedOut">
                <span class="acesso__giro" aria-hidden="true"></span>
                <span class="acesso__entrar-ocioso">Entrar</span>
                <span class="acesso__entrar-enviando">Verificando…</span>
            </button>

            <div class="acesso__dica">
                <b>Esqueceu a senha?</b> Não há redefinição pela tela. A troca é feita com
                acesso ao servidor — procure quem administra a instalação.
            </div>
        </EditForm>
    </div>
</div>
</div>

<script>
    // Alternar a visibilidade da senha exige trocar o `type` do campo, o que nenhum
    // modo de renderização do servidor faz sem ida e volta — e uma ida ao servidor
    // carregando a senha em claro seria pior que o problema. Mesma exceção pontual à
    // ADR-001 já aberta para o estado de envio.
    document.querySelectorAll('[data-ver-senha]').forEach(botao => {
        botao.addEventListener('click', () => {
            const campo = document.getElementById(botao.dataset.verSenha);
            if (!campo) { return; }

            const revelando = campo.type === 'password';
            campo.type = revelando ? 'text' : 'password';

            botao.setAttribute('aria-pressed', String(revelando));
            botao.setAttribute('aria-label', revelando ? 'Ocultar senha' : 'Mostrar senha');

            campo.focus();
        });
    });

    document.querySelector('[data-estado-enviando="acesso"]')?.addEventListener('submit', event => {
        const form = event.currentTarget;

        // Segundo envio enquanto o primeiro está em voo: barra antes de sair.
        if (form.dataset.enviando) { event.preventDefault(); return; }

        form.dataset.enviando = 'true';

        // Campo desabilitado não é enviado no POST — daí `readOnly` nos campos e
        // `disabled` apenas no botão, que não carrega valor.
        form.querySelectorAll('input').forEach(field => field.readOnly = true);
        form.querySelectorAll('button').forEach(button => button.disabled = true);
    });
</script>

@code {
    [SupplyParameterFromForm]
    private Credentials Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = PanelAuthentication.ReturnUrlParameter)]
    private string? ReturnUrl { get; set; }

    private bool failed;
    private bool isLockedOut => lockedOutMinutes is not null;
    private int? lockedOutMinutes;

    private async Task AuthenticateAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.UserName,
            Input.Password,
            isPersistent: false,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo(ReturnUrl ?? PanelAuthentication.PanelPathPrefix);
            return;
        }

        if (result.IsLockedOut)
        {
            lockedOutMinutes = (int)Math.Ceiling(PanelAuthentication.LockoutDuration.TotalMinutes);
            return;
        }

        // A mensagem não distingue usuário inexistente de senha errada: dizer qual dos
        // dois falhou entrega metade da credencial a quem tenta adivinhar (UI-03).
        failed = true;
    }

    private sealed class Credentials
    {
        [Required]
        public string UserName { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
