@inherits LayoutComponentBase
@using Catalogo.Features.Settings
@inject PortalSettingsService Settings

@*
    Cromo da vitrine — faixa utilitária, cabeçalho com marca e busca, e rodapé.

    Existe porque estava duplicado literalmente entre UI-01 e UI-02 (R-02 de
    `REVIEW-T-19-2026-09-28`, R-03 de `REVIEW-T-20-2026-09-28`). Os dados de contato da
    RN-67 são lidos **uma vez por requisição** e descem por cascata: o rodapé e o bloco de
    contato do detalhe consomem a mesma leitura, e a regra "um lugar só, para não
    divergirem" passa a valer por estrutura em vez de disciplina.

    Sem `@@rendermode`: o layout não pode reintroduzir circuito na área estática (ADR-010).
*@

<CascadingValue Value="contact">
    <div class="vitrine">
        <div class="util">
            <div class="util__in">
                <span class="util__pill">Catálogo</span>
                <span>Atendimento Seg–Sex 08h–18h</span>
            </div>
        </div>

        <header class="cabeca">
            <div class="cabeca__in">
                <a class="marca" href="/">
                    <span class="marca__m">CT</span>
                    <span>
                        <span class="marca__t">CATÁLOGO</span>
                        <span class="marca__s">Suprimentos &amp; Informática</span>
                    </span>
                </a>

                @* GET, e não POST: a busca precisa virar URL para o resultado ser
                   compartilhável (RN-56) e para o cache de T-21 ter o que guardar. *@
                <form class="busca" method="get" action="/" role="search">
                    <input type="search" name="@SearchParameter" value="@SearchTerm"
                           aria-label="Buscar produto pelo nome"
                           placeholder="Buscar pelo nome do produto" />
                    <button type="submit" aria-label="Buscar">⌕</button>
                </form>
            </div>
        </header>

        @Body

        <footer class="rodape">
            <div class="rodape__c">
                <b>Suprimentos &amp; Informática</b>
                <em>Atendimento de segunda a sexta, das 08h às 18h</em>
            </div>

            @* Lido a cada requisição — é o que faz a alteração do contato refletir na
               vitrine imediatamente (RN-68, CA-38). *@
            <ContatosVitrine />
        </footer>
    </div>
</CascadingValue>

@code {
    public const string SearchParameter = "busca";

    private PortalSettings? contact;

    protected override async Task OnInitializedAsync() => contact = await Settings.LoadAsync();

    /// <summary>
    /// O campo mostra o termo corrente quando ele existe na URL. Vem do parâmetro de
    /// consulta e não do componente filho, porque o cabeçalho é do layout — e a página de
    /// detalhe, que não tem termo, simplesmente recebe vazio.
    /// </summary>
    [SupplyParameterFromQuery(Name = SearchParameter)]
    public string? SearchTerm { get; set; }
}
