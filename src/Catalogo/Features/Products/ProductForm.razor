@page "/painel/produtos/novo"
@page "/painel/produtos/{Id:int}"
@layout PanelLayout
@rendermode InteractiveServer
@using Catalogo.Features.Media
@inject ProductMaintenance Maintenance
@inject ProductPhotoService PhotoService
@inject ProductRemoval Removal
@inject ProductPhotoUpload Upload
@inject ProductPublication Publication
@inject ILogger<ProductForm> Logger
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Novo produto" : "Editar produto")</PageTitle>

<div class="painel">
    <h1>@(Id is null ? "Novo produto" : "Editar produto")</h1>
    <div class="painel__sub">
        O que é cadastrado aqui alimenta a vitrine e os catálogos em PDF.
    </div>

    <div class="painel__folha" data-estado="@(Id is null ? "novo" : "edicao")">
        @if (notFound)
        {
            <div class="painel-bloco">
                <div class="painel-bloco__bd">
                    <p>Produto não encontrado. Ele pode ter sido excluído.</p>
                    <a class="btn" href="/painel">Voltar ao painel</a>
                </div>
            </div>
        }
        else if (categories is null)
        {
            <p>Carregando…</p>
        }
        else if (categories.Count == 0)
        {
            <div class="painel-bloco">
                <div class="painel-bloco__bd">
                    <h2>Nenhuma categoria cadastrada</h2>
                    <p>
                        Todo produto pertence a exatamente uma categoria, então a categoria
                        vem antes. Crie a primeira para poder cadastrar produtos.
                    </p>
                    <a class="btn btn--primario" href="/painel/categorias">Ir para categorias</a>
                </div>
            </div>
        }
        else
        {
            <div class="painel-bloco">
                <div class="painel-bloco__hd">
                    <h2>Dados do produto</h2>
                    <span class="selo @(IsPublished ? "selo--no-ar" : "selo--rascunho")">
                        <span class="selo__ponto"></span>@(IsPublished ? "No ar" : "Rascunho")
                    </span>
                </div>

                <div class="painel-bloco__bd produto__campos">
                    <div class="campo @(ErrorClass(ProductField.Name))">
                        <label class="campo__rotulo" for="nome">
                            Nome <span class="campo__obrigatorio">*</span>
                        </label>
                        <input id="nome" type="text" @bind="draft.Name" @bind:event="oninput"
                               maxlength="@Product.NameMaxLength" placeholder="Como o produto se chama" />
                        <span class="campo__ajuda">
                            Aparece na vitrine, na página de detalhe e na célula do PDF.
                        </span>
                        @if (ErrorFor(ProductField.Name) is { } nameError)
                        {
                            <span class="campo__erro" role="alert">@nameError</span>
                        }
                    </div>

                    <div class="campo @(ErrorClass(ProductField.Summary))">
                        <label class="campo__rotulo" for="resumo">Resumo</label>
                        <input id="resumo" type="text" @bind="draft.Summary" @bind:event="oninput"
                               placeholder="Uma linha com o essencial" />
                        <span class="campo__ajuda">
                            Aparece na <b>célula do PDF</b> e no card da listagem — não na
                            página de detalhe. Deixe vazio e a célula mostra só nome e preço.
                        </span>
                        <span class="campo__contador @(SummaryOverflow ? "campo__contador--estourado" : null)">
                            @SummaryLength / @Product.SummaryMaxLength
                        </span>
                        @if (ErrorFor(ProductField.Summary) is { } summaryError)
                        {
                            <span class="campo__erro" role="alert">@summaryError</span>
                        }
                    </div>

                    <div class="campo">
                        <label class="campo__rotulo" for="descricao">Descrição</label>
                        <textarea id="descricao" @bind="draft.Description" @bind:event="oninput"
                                  placeholder="A especificação completa, sem limite de tamanho"></textarea>
                        <span class="campo__ajuda">
                            Aparece <b>apenas na página de detalhe</b> da vitrine. Não entra
                            no PDF nem na listagem.
                        </span>
                    </div>

                    <div class="produto__linha">
                        <div class="campo @(ErrorClass(ProductField.Price))">
                            <label class="campo__rotulo" for="preco">
                                Preço <span class="campo__obrigatorio">*</span>
                            </label>
                            <input id="preco" type="number" step="0.01" min="0"
                                   @bind="draft.Price" @bind:event="oninput" placeholder="0,00" />
                            @if (ErrorFor(ProductField.Price) is { } priceError)
                            {
                                <span class="campo__erro" role="alert">@priceError</span>
                            }
                        </div>

                        <div class="campo">
                            <label class="campo__rotulo" for="rotulo">Rótulo</label>
                            <select id="rotulo" @bind="draft.PriceLabel">
                                <option value="@PriceLabel.Price">PREÇO</option>
                                <option value="@PriceLabel.PricePerUnit">PREÇO/UND</option>
                            </select>
                            <span class="campo__ajuda">Impresso acima do valor no PDF.</span>
                        </div>
                    </div>

                    <div class="campo @(ErrorClass(ProductField.Category))">
                        <label class="campo__rotulo" for="categoria">
                            Categoria <span class="campo__obrigatorio">*</span>
                        </label>
                        <select id="categoria" @bind="draft.CategoryId">
                            <option value="">Escolha uma categoria</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        @if (ErrorFor(ProductField.Category) is { } categoryError)
                        {
                            <span class="campo__erro" role="alert">@categoryError</span>
                        }
                    </div>
                </div>

                <div class="painel-bloco__bd produto__foto">
                    <span class="campo__rotulo">Foto</span>

                    @if (Id is null)
                    {
                        <p class="campo__ajuda">
                            Salve o produto primeiro. A foto é enviada e processada no
                            servidor, e precisa de um produto para se associar.
                        </p>
                    }
                    else
                    {
                        <p class="campo__ajuda">
                            Uma foto por produto — enviar outra substitui a atual. Dela saem
                            quatro versões: três para a tela e uma para a impressão.
                        </p>

                        @if (photo is not null)
                        {
                            <div class="produto__derivadas" data-estado="comFoto">
                                <img src="@PublicUrl(photo.CardFileName)" alt="Foto de @draft.Name" />

                                <ul class="mono">
                                    <li>miniatura · @photo.ThumbnailFileName</li>
                                    <li>cartão · @photo.CardFileName</li>
                                    <li>ampliada · @photo.LargeFileName</li>
                                    <li>impressão · @photo.PrintFileName</li>
                                </ul>
                            </div>
                        }

                        <label class="btn @(uploading ? "" : "btn--primario")">
                            @(photo is null ? "Enviar foto" : "Trocar foto")
                            <InputFile OnChange="UploadAsync" accept="image/*" disabled="@uploading"
                                       class="visualmente-oculto" />
                        </label>

                        @if (uploading)
                        {
                            <p class="campo__ajuda" role="status" data-estado="enviandoFoto">
                                Enviando e gerando as derivadas… salvar fica indisponível até terminar.
                            </p>
                        }

                        @if (uploadError is not null)
                        {
                            <p class="campo__erro" role="alert" data-estado="erroUpload">
                                @uploadError @(photo is not null ? "A foto anterior foi mantida." : null)
                            </p>
                        }
                    }
                </div>

                @if (publication is { } state)
                {
                    <div class="painel-bloco__bd produto__situacao"
                         data-estado="@(state.CanPublish ? null : "publicacaoBloqueada")">
                        <span class="campo__rotulo">Situação</span>

                        @* Controle segmentado do protótipo, agora em `painel.css`. Antes
                           eram dois botões soltos, e o único com estilo de estado era o
                           desabilitado — que é sempre o da situação vigente, invertendo a
                           afordância (R-05 de REVIEW-T-14-2026-09-28). Com o `.seg`, o
                           estado atual é marcado por cor, e `disabled` volta a significar
                           apenas indisponível. *@
                        <div class="seg" role="group" aria-label="Situação do produto">
                            <button type="button"
                                    aria-pressed="@(!IsPublished)"
                                    disabled="@(uploading || !IsPublished)"
                                    @onclick="WithdrawAsync">Rascunho</button>
                            <button type="button"
                                    aria-pressed="@IsPublished"
                                    disabled="@(uploading || IsPublished || !state.CanPublish)"
                                    @onclick="PublishAsync">No ar</button>
                        </div>

                        @if (!state.CanPublish)
                        {
                            <span class="campo__erro" role="alert">
                                @MissingMessage(state.Missing)
                            </span>
                        }
                        else if (publicationRefusal is { } refusal)
                        {
                            <span class="campo__erro" role="alert">@refusal</span>
                        }

                        <span class="campo__ajuda">
                            Rascunho fica fora da vitrine e de todos os catálogos. Publicar
                            insere o produto, na hora, em todo catálogo salvo cuja categoria
                            ele atende — não existe passo de "adicionar ao catálogo".
                        </span>
                    </div>
                }

                <div class="painel-bloco__ft">
                    <button type="button" class="btn btn--primario" @onclick="SaveAsync"
                            disabled="@uploading">Salvar</button>
                    <a class="btn btn--fantasma" href="/painel">Cancelar</a>

                    @* A exclusão só existe na edição: não há o que excluir num produto que
                       ainda não foi criado (RN-20). *@
                    @if (Id is not null && !confirmingDeletion)
                    {
                        <button type="button" class="btn btn--perigo" @onclick="AskDeletionAsync"
                                disabled="@uploading">Excluir</button>
                    }

                    @if (saved)
                    {
                        <span class="produto__salvo" role="status">Produto salvo.</span>
                    }
                </div>

                @if (confirmingDeletion)
                {
                    @* UI-05.confirmarExclusao. A confirmação é do **dono**, nunca automática:
                       a operação não tem volta e leva a foto junto (RN-20). O que ela declara
                       é exatamente o que vai acontecer — sem eufemismo. *@
                    <div class="painel-bloco__ft" data-estado="confirmarExclusao">
                        <p class="campo__erro" role="alert">
                            <b>Excluir “@confirmedName” definitivamente?</b><br />
                            Esta operação <b>não pode ser desfeita</b>. O produto sai do
                            acervo e @(photo is null
                                ? "nenhum arquivo de imagem será removido, porque este produto não tem foto"
                                : "a foto e todas as suas versões são removidas junto").
                            @if (deletionAffectsStorefront)
                            {
                                <text>
                                    Ele está <b>No ar</b>: deixa de aparecer na vitrine, e os
                                    links já compartilhados para ele param de funcionar.
                                </text>
                            }
                        </p>

                        <button type="button" class="btn btn--perigo" @onclick="DeleteAsync"
                                disabled="@deleting">Excluir definitivamente</button>

                        <button type="button" class="btn btn--fantasma"
                                @onclick="CancelDeletion" disabled="@deleting">
                            Manter o produto
                        </button>
                    </div>
                }

                @* Erro **da exclusão**, junto da ação que falhou. Antes reusava o campo do
                   envio de foto, o que fazia a tela dizer "a foto anterior foi mantida" para
                   uma exclusão que nem envolveu foto, dentro do estado `erroUpload` que a
                   SPEC-UI define para outra coisa. *@
                @if (deletionError is { } removalError)
                {
                    <div class="painel-bloco__ft">
                        <p class="campo__erro" role="alert" data-estado="erroExclusao">
                            @removalError <br />
                            <span class="campo__ajuda">O produto continua no acervo.</span>
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProductDraft draft = new();
    private IReadOnlyList<Category>? categories;
    private IReadOnlyDictionary<ProductField, string> errors =
        new Dictionary<ProductField, string>();

    private bool notFound;
    private bool saved;

    private bool confirmingDeletion;
    private bool deleting;
    private bool deletionAffectsStorefront;
    private string? deletionError;

    /// <summary>
    /// O nome como estava **gravado** quando a confirmação foi pedida. O campo do formulário
    /// muda a cada tecla, e a confirmação existe para confirmar identidade: "Excluir “Cab HD”?"
    /// não identifica nada.
    /// </summary>
    private string? confirmedName;

    private ProductPhoto? photo;
    private bool uploading;
    private string? uploadError;

    private PublicationState? publication;
    private string? publicationRefusal;

    private bool IsPublished => publication?.Status == ProductStatus.Published;

    private async Task UploadAsync(InputFileChangeEventArgs change)
    {
        uploadError = null;
        uploading = true;

        try
        {
            var file = change.File;

            // O limite do leitor precisa ser explícito: o padrão do Blazor é 512 KB, e
            // o que decide a recusa é a validação do pipeline (RN-10), não o transporte.
            await using var content = file.OpenReadStream(ImageValidation.MaxFileSizeInBytes);

            var outcome = await Upload.StoreAsync(Id!.Value, content, file.Size);

            uploadError = outcome.Error;

            // Sem foto nova, a anterior continua na tela — é o que a UI-05 exige do
            // estado de erro, junto da preservação do que já estava digitado.
            photo = outcome.Photo ?? photo;

            // A foto é uma das quatro exigências da RN-16: recém-enviada, ela pode ter
            // sido a última pendência da publicação.
            await LoadPublicationAsync();
        }
        catch (Exception exception)
        {
            // Último limite antes do circuito: exceção que escape daqui encerra a sessão
            // do painel e leva o formulário inteiro com ela (ADR-010).
            Logger.LogError(exception, "Falha inesperada no envio da foto do produto {ProductId}.", Id);
            uploadError = ProductPhotoUpload.StorageUnavailableMessage;
        }
        finally
        {
            uploading = false;
        }
    }

    private string PublicUrl(string objectName) => PhotoService.PublicUrlFor(objectName);

    private int SummaryLength => draft.Summary?.Trim().Length ?? 0;
    private bool SummaryOverflow => SummaryLength > Product.SummaryMaxLength;

    protected override async Task OnParametersSetAsync()
    {
        categories = await Maintenance.ListCategoriesAsync();

        if (Id is null)
        {
            Reset();
            return;
        }

        var existing = await Maintenance.FindAsync(Id.Value);
        notFound = existing is null;
        draft = existing ?? new ProductDraft();

        photo = notFound ? null : await Maintenance.FindPhotoAsync(Id.Value);

        await LoadPublicationAsync();
    }

    private async Task LoadPublicationAsync()
    {
        publication = Id is null || notFound ? null : await Publication.FindStateAsync(Id.Value);
    }

    /// <summary>
    /// As duas rotas são do mesmo componente, então o roteador reaproveita a instância ao
    /// passar de um produto para o cadastro em branco. Todo estado carregado do produto
    /// anterior precisa sair junto: deixar `publication` para trás renderizaria o
    /// alternador de situação sem `Id`, e o clique estouraria dentro do manipulador de
    /// evento, sem limite acima dele (R-01 de `REVIEW-T-14-2026-09-28`).
    /// </summary>
    private void Reset()
    {
        draft = new ProductDraft();
        errors = new Dictionary<ProductField, string>();
        notFound = false;
        saved = false;
        photo = null;
        uploadError = null;
        publication = null;
        publicationRefusal = null;
    }

    private async Task PublishAsync()
    {
        publicationRefusal = null;

        if (Id is null)
        {
            return;
        }

        var outcome = await Publication.PublishAsync(Id.Value);

        if (outcome is null)
        {
            notFound = true;
            publication = null;
            return;
        }

        // A recusa vem do que está gravado, não do que a tela supunha (RN-17): o estado
        // recarregado é o que passa a nomear a pendência.
        if (!outcome.Succeeded)
        {
            publicationRefusal = MissingMessage(outcome.Missing);
        }

        await LoadPublicationAsync();
    }

    private async Task WithdrawAsync()
    {
        publicationRefusal = null;

        if (Id is null)
        {
            return;
        }

        var outcome = await Publication.WithdrawAsync(Id.Value);

        if (outcome is null)
        {
            notFound = true;
            publication = null;
            return;
        }

        await LoadPublicationAsync();
    }

    /// <summary>A tela nomeia o que falta em vez de apenas desabilitar a ação (RN-17).</summary>
    private static string MissingMessage(IReadOnlyList<PublicationRequirement> missing) =>
        missing.Count == 1
            ? $"Falta {Label(missing[0])} para publicar."
            : $"Faltam {string.Join(", ", missing.Select(Label))} para publicar.";

    private static string Label(PublicationRequirement requirement) => requirement switch
    {
        PublicationRequirement.Name => "o nome",
        PublicationRequirement.Price => "o preço",
        PublicationRequirement.Category => "a categoria",
        PublicationRequirement.Photo => "a foto",
        _ => "um campo obrigatório"
    };

    private async Task SaveAsync()
    {
        saved = false;

        var outcome = await Maintenance.SaveAsync(draft);
        errors = outcome.Errors;

        if (!outcome.Succeeded)
        {
            return;
        }

        saved = true;

        // Nome, preço e categoria são três das quatro exigências da RN-16, então salvar
        // pode aproximar ou afastar a publicação.
        await LoadPublicationAsync();

        if (Id is null)
        {
            Navigation.NavigateTo($"/painel/produtos/{outcome.Id}");
        }
    }

    /// <summary>
    /// Abre a confirmação. Não exclui nada: o botão de excluir **pede**, o da confirmação
    /// executa (RN-20). A situação é relida aqui, e não tirada do que a tela carregou, porque
    /// a confirmação afirma se o produto está no ar — e isso pode ter mudado noutra aba.
    /// </summary>
    /// <summary>
    /// Abre a confirmação. Não exclui nada: o botão de excluir **pede**, o da confirmação
    /// executa (RN-20).
    ///
    /// Tudo o que a confirmação afirma é relido do banco aqui — a situação **e a foto**. As
    /// duas são afirmações factuais no texto, e a tela pode estar aberta desde antes de outra
    /// aba ter enviado uma foto ou publicado o produto; afirmar "este produto não tem foto" e
    /// apagar cinco arquivos em seguida seria mentir no único momento em que o dono precisa
    /// confiar no que lê.
    /// </summary>
    private async Task AskDeletionAsync()
    {
        saved = false;
        deletionError = null;

        await LoadPublicationAsync();

        if (publication is null)
        {
            // Excluído noutra aba: não há o que confirmar.
            notFound = true;
            return;
        }

        photo = await Maintenance.FindPhotoAsync(Id!.Value);

        // O nome vem do **gravado**, não do campo. `draft.Name` está ligado ao `oninput`: quem
        // tivesse trocado o nome sem salvar veria a confirmação nomear o texto digitado e o clique
        // apagaria outro produto — o que a própria documentação deste método promete não acontecer.
        confirmedName = publication.Name;
        deletionAffectsStorefront = IsPublished;
        confirmingDeletion = true;
    }

    private void CancelDeletion() => confirmingDeletion = false;

    private async Task DeleteAsync()
    {
        // Trava de reentrância: dois cliques antes do re-render disparariam duas exclusões, e
        // `disabled` no markup não impede a segunda chamada já em voo.
        if (deleting)
        {
            return;
        }

        deleting = true;

        var outcome = await Removal.RemoveAsync(Id!.Value);

        if (!outcome.Succeeded)
        {
            deleting = false;
            confirmingDeletion = false;
            deletionError = outcome.Error;
            return;
        }

        Navigation.NavigateTo("/painel/produtos");
    }

    private string? ErrorFor(ProductField field) =>
        errors.TryGetValue(field, out var message) ? message : null;

    private string? ErrorClass(ProductField field) =>
        errors.ContainsKey(field) ? "campo--erro" : null;
}
