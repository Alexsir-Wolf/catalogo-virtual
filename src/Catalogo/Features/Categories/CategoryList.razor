@page "/painel/categorias"
@layout PanelLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits PanelPageBase
@rendermode InteractiveServer
@inject CategoryMaintenance Maintenance

<PageTitle>Categorias</PageTitle>

<h1>Categorias</h1>

<p class="categorias__nota">
    A numeração abaixo é a global. Em um catálogo parcial ela é recalculada, então uma
    categoria que aparece como 03 aqui pode sair como 01 no PDF.
</p>

<form class="categorias__novo" @onsubmit="CreateAsync" @onsubmit:preventDefault>
    <label for="nova-categoria">Nova categoria</label>
    <input id="nova-categoria" @bind="newName" @bind:event="oninput"
           maxlength="@Category.NameMaxLength" aria-invalid="@(failure is not null)" />
    <button type="submit">Adicionar</button>

    @if (failure is not null)
    {
        <p class="categorias__erro" role="alert" data-estado="@StateIdFor(failure.Value)">
            @MessageFor(failure.Value)
        </p>
    }
</form>

@if (categories is null)
{
    <p>Carregando…</p>
}
else if (categories.Count == 0)
{
    <div class="categorias__vazio" data-estado="vazio">
        <h2>Nenhuma categoria ainda</h2>
        <p>
            A categoria é pré-requisito de qualquer produto — todo produto pertence a
            exatamente uma. Crie a primeira acima para começar o acervo.
        </p>
    </div>
}
else
{
    <table class="categorias__lista" data-estado="default">
        <thead>
            <tr>
                <th scope="col">Nº</th>
                <th scope="col">Nome</th>
                <th scope="col"><span class="visually-hidden">Ações</span></th>
            </tr>
        </thead>
        <tbody>
            @for (var index = 0; index < categories.Count; index++)
            {
                var category = categories[index];
                var number = (index + 1).ToString("00");

                <tr>
                    <td class="categorias__numero">@number</td>
                    <td>
                        @if (editingId == category.Id)
                        {
                            <input @bind="editingName" @bind:event="oninput"
                                   maxlength="@Category.NameMaxLength" aria-label="Nome da categoria" />
                        }
                        else
                        {
                            @category.Name
                        }
                    </td>
                    <td>
                        @if (editingId == category.Id)
                        {
                            <button type="button" @onclick="() => RenameAsync(category.Id)">Salvar</button>
                            <button type="button" @onclick="CancelEditing">Cancelar</button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => MoveAsync(category.Id, MoveDirection.Up)"
                                    disabled="@(index == 0)" aria-label="Subir @category.Name">↑</button>
                            <button type="button" @onclick="() => MoveAsync(category.Id, MoveDirection.Down)"
                                    disabled="@(index == categories.Count - 1)" aria-label="Descer @category.Name">↓</button>
                            <button type="button" @onclick="() => StartEditing(category)">Renomear</button>

                            @if (pendingDeletionId == category.Id)
                            {
                                <button type="button" class="categorias__confirmar"
                                        @onclick="() => DeleteAsync(category.Id)">Confirmar exclusão</button>
                                <button type="button" @onclick="() => pendingDeletionId = null">Cancelar</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => AskDeletion(category.Id)">Excluir</button>
                            }
                        }

                        @if (blockedId == category.Id && blockingProducts > 0)
                        {
                            <p class="categorias__erro" role="alert" data-estado="bloqueadaPorProdutos">
                                Não dá para excluir: @blockingProducts produto(s) pertencem a esta
                                categoria, inclusive rascunhos. Mova-os para outra categoria ou
                                exclua-os antes.
                            </p>
                        }

                        @* RN-25.1 com mensagem **própria**, e não uma variação da de produtos: a
                           causa é outra e a saída também. Lá o dono move ou exclui produtos; aqui
                           ele edita o critério de um catálogo. "Categoria em uso" para os dois
                           casos deixaria a pessoa sem saber o que fazer. *@
                        @if (blockedId == category.Id && blockingCatalogs.Count > 0)
                        {
                            <p class="categorias__erro" role="alert" data-estado="bloqueadaPorCatalogo">
                                Não dá para excluir: esta categoria integra o critério
                                @(blockingCatalogs.Count == 1 ? "do catálogo" : "dos catálogos")
                                <b>@string.Join(", ", blockingCatalogs)</b>. Retire-a do critério
                                @(blockingCatalogs.Count == 1 ? "dele" : "deles") antes, ou o
                                catálogo ficaria sem critério resolvível.
                            </p>
                        }

                        @* A recusa que **não tem o que nomear** (RN-25.1): o banco barrou a
                           exclusão e a reconsulta não achou o impedimento, porque ele apareceu e
                           sumiu em outra aba. Os dois blocos acima dependem de payload, então sem
                           este a recusa chegaria como silêncio — o dono clicaria de novo e
                           repetiria a mesma corrida. Aqui o próximo passo não é mover produto nem
                           editar critério: é ler o estado novo, que a lista já recarregou. *@
                        @if (blockedId == category.Id && blockedWithoutPayload)
                        {
                            <p class="categorias__erro" role="alert" data-estado="bloqueadaPorConcorrencia">
                                @ConcurrentChangeMessage
                            </p>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<Category>? categories;
    private string newName = string.Empty;
    private CategoryFailure? failure;

    private int? editingId;
    private string editingName = string.Empty;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task CreateAsync()
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        var outcome = await Maintenance.CreateAsync(newName);
        failure = outcome.Succeeded ? null : outcome.Failure;

        if (outcome.Succeeded)
        {
            newName = string.Empty;
            await ReloadAsync();
        }
    }

    private void StartEditing(Category category)
    {
        editingId = category.Id;
        editingName = category.Name;
        failure = null;
    }

    private void CancelEditing()
    {
        editingId = null;
        editingName = string.Empty;
    }

    private async Task RenameAsync(int id)
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        var outcome = await Maintenance.RenameAsync(id, editingName);
        failure = outcome.Succeeded ? null : outcome.Failure;

        if (outcome.Succeeded)
        {
            CancelEditing();
            await ReloadAsync();
        }
    }

    private int? pendingDeletionId;
    private int? blockedId;
    private int blockingProducts;
    private IReadOnlyList<string> blockingCatalogs = [];
    private bool blockedWithoutPayload;

    /// <summary>
    /// Texto da recusa que não consegue nomear quem bloqueia. Fica em constante, e não no meio do
    /// markup, porque é o único trecho da tela que o teste consegue morder sem bUnit — e é
    /// justamente o que não pode voltar a ser silêncio.
    /// </summary>
    public const string ConcurrentChangeMessage =
        "Não deu para excluir: a categoria passou a ser usada enquanto você confirmava, " +
        "provavelmente em outra aba. A lista acima já foi recarregada — confira o estado " +
        "atual e tente de novo.";

    /// <summary>
    /// Recusa sem nada a nomear: nem produto para contar, nem catálogo para citar. É o que os dois
    /// blocos de payload não conseguem desenhar, e por isso precisa de bloco próprio — nenhum
    /// resultado sem sucesso pode chegar à tela sem texto.
    /// </summary>
    public static bool RequiresGenericRefusal(CategoryDeletionOutcome outcome) =>
        !outcome.Succeeded && outcome.BlockingProducts == 0 && outcome.Catalogs.Count == 0;

    /// <summary>
    /// A exclusão é definitiva, então exige um segundo clique deliberado. Nunca
    /// confirmar em nome do usuário.
    /// </summary>
    private void AskDeletion(int id)
    {
        pendingDeletionId = id;
        blockedId = null;
    }

    private async Task DeleteAsync(int id)
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        var outcome = await Maintenance.DeleteAsync(id);
        pendingDeletionId = null;

        if (outcome.Succeeded)
        {
            blockedId = null;
            await ReloadAsync();
            return;
        }

        blockedId = id;
        blockingProducts = outcome.BlockingProducts;
        blockingCatalogs = outcome.Catalogs;
        blockedWithoutPayload = RequiresGenericRefusal(outcome);

        // Recarregar também na recusa: se a exclusão foi barrada, a lista em tela descreve um
        // estado que o banco já não confirma — no caso da corrida, por definição.
        await ReloadAsync();
    }

    private async Task MoveAsync(int id, MoveDirection direction)
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        await Maintenance.MoveAsync(id, direction);
        await ReloadAsync();
    }

    private async Task ReloadAsync() => categories = await Maintenance.ListAsync();

    private static string MessageFor(CategoryFailure failure) => failure switch
    {
        CategoryFailure.NameRequired => "Informe o nome da categoria.",
        CategoryFailure.NameAlreadyInUse => "Já existe uma categoria com esse nome.",
        _ => string.Empty
    };

    private static string StateIdFor(CategoryFailure failure) => failure switch
    {
        CategoryFailure.NameAlreadyInUse => "nomeDuplicado",
        _ => "nomeObrigatorio"
    };
}
