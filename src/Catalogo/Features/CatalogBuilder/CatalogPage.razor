@page "/painel/catalogos/novo"
@page "/painel/catalogos/{Id:int}"
@rendermode InteractiveServer
@using Catalogo.Features.Categories
@using System.Globalization
@inject CatalogMaintenance Maintenance
@inject CatalogResolution Resolution
@inject CategoryMaintenance Categories
@inject NavigationManager Navigation

@*
    UI-08, primeira parte: o **critério**. A prévia e a geração são T-23 e T-25, e é por isso
    que esta tela ainda não tem o lado direito que a SPEC-UI desenha.

    O que a tela declara em voz alta é o que a ADR-014 decidiu: salva-se o critério, não a
    lista. Sem essa frase, o dono supõe que o catálogo é um pacote fechado de produtos — e a
    contagem mudando entre visitas pareceria defeito.
*@

<PageTitle>@(Id is null ? "Novo catálogo" : "Catálogo")</PageTitle>

<div class="painel">
    <h1>@(Id is null ? "Novo catálogo" : "Catálogo")</h1>
    <div class="painel__sub">
        Nome e categorias. É isso que fica salvo.
    </div>

    <div class="painel__folha" data-estado="@StateId">
        @if (notFound)
        {
            <div class="nada" data-estado="naoEncontrado">
                <h2>Catálogo não encontrado</h2>
                <p>Ele pode ter sido excluído em outra aba.</p>
                <a href="/painel/catalogos">Ver todos os catálogos</a>
            </div>
        }
        else if (categories is null)
        {
            <p>Carregando…</p>
        }
        else
        {
            <div class="painel-bloco">
                <div class="painel-bloco__hd">
                    <h2>Critério</h2>
                </div>

                <div class="painel-bloco__bd produto__campos">
                    <p class="campo__ajuda">
                        O que fica salvo é <b>o critério</b>, não a lista de produtos. Gerar
                        este catálogo em outra data produz o acervo daquela data — é o que
                        evita que um catálogo envelheça sozinho.
                    </p>

                    <div class="campo">
                        <label class="campo__rotulo" for="nome">Nome</label>
                        <input id="nome" type="text" @bind="draft.Name"
                               maxlength="@Catalog.NameMaxLength"
                               placeholder="Consumíveis" />

                        @if (failure is CatalogFailure.NameRequired or CatalogFailure.NameAlreadyInUse)
                        {
                            <span class="campo__erro" role="alert">@MessageFor(failure.Value)</span>
                        }
                    </div>

                    <fieldset class="campo">
                        <legend class="campo__rotulo">Categorias</legend>

                        @if (categories.Count == 0)
                        {
                            <p class="campo__erro" role="alert">
                                Não há categorias cadastradas. Um catálogo precisa de pelo
                                menos uma — <a href="/painel/categorias">crie a primeira</a>.
                            </p>
                        }

                        @foreach (var category in categories)
                        {
                            <label class="campo__opcao">
                                <input type="checkbox"
                                       checked="@draft.CategoryIds.Contains(category.Id)"
                                       @onchange="changed => Toggle(category.Id, changed)" />
                                <span>@category.Name</span>
                            </label>
                        }

                        @* RN-28: abranger o acervo inteiro é marcar todas, não deixar nenhuma
                           marcada. A tela precisa dizer isso, senão "nenhuma" parece "todas". *@
                        <span class="campo__ajuda">
                            Marque ao menos uma. Para abranger o acervo inteiro, marque
                            todas — deixar nenhuma marcada não significa "todas".
                        </span>

                        @if (failure is CatalogFailure.NoCategorySelected)
                        {
                            <span class="campo__erro" role="alert" data-estado="semCategoria">
                                @MessageFor(failure.Value)
                            </span>
                        }
                    </fieldset>
                </div>

                <div class="painel-bloco__ft">
                    <button type="button" class="btn btn--primario" @onclick="SaveAsync"
                            disabled="@(draft.CategoryIds.Count == 0)">
                        Salvar critério
                    </button>

                    <a class="btn btn--fantasma" href="/painel/catalogos">Voltar</a>

                    @if (saved)
                    {
                        <span class="produto__salvo" role="status" data-estado="salvo">
                            Critério salvo.
                        </span>
                    }
                </div>
            </div>

            @* RN-31: a prévia **precede a geração, sempre**. Não existe caminho que a pule, e
               é por isso que ela não é uma aba nem um modal: é o corpo da tela, ao lado do
               critério. Um botão "gerar direto" anularia a proteção que justifica a ADR-014. *@
            @if (Id is not null)
            {
                <div class="painel-bloco">
                    <div class="painel-bloco__hd">
                        <h2>Prévia do que vai sair</h2>

                        @if (resolved is { IsEmpty: false } preview)
                        {
                            <span class="selo selo--no-ar">
                                @preview.ProductCount @(preview.ProductCount == 1 ? "produto" : "produtos")
                            </span>
                            <span class="selo selo--rascunho">
                                ~@preview.EstimatedPages @(preview.EstimatedPages == 1 ? "página" : "páginas")
                            </span>
                        }
                    </div>

                    <div class="painel-bloco__bd">
                        @if (resolved is null)
                        {
                            <p class="campo__ajuda">Salve o critério para ver a prévia.</p>
                        }
                        else if (resolved.IsEmpty)
                        {
                            @* RN-46 / CA-18: nenhum produto No ar atende ao critério. A razão
                               precisa estar na tela — "nada aqui" sem motivo faz o dono achar
                               que o catálogo quebrou, quando o acervo é que está em Rascunho. *@
                            <p class="campo__erro" role="alert" data-estado="previaVazia">
                                <b>Nenhum produto No ar atende a este critério.</b><br />
                                <span class="campo__ajuda">
                                    A geração está indisponível. Produtos em Rascunho não saem
                                    no documento — confira a situação deles nas categorias
                                    escolhidas.
                                </span>
                            </p>
                        }
                        else
                        {
                            @if (resolved.HasNewProducts)
                            {
                                @* RN-32: o destaque é a mitigação do risco central do sistema.
                                   O dono gera achando que conhece o conteúdo; sem este aviso,
                                   descobre no cliente que algo entrou. *@
                                <p class="campo__ajuda" role="status" data-estado="comItensNovos">
                                    <b>@resolved.NewSinceLastGeneration
                                    @(resolved.NewSinceLastGeneration == 1 ? "produto entrou" : "produtos entraram")
                                    neste catálogo desde a última geração.</b>
                                    Estão marcados na lista abaixo.
                                </p>
                            }

                            <p class="campo__ajuda">
                                A numeração abaixo é a <b>deste recorte</b>: uma categoria que é
                                a 6ª no cadastro sai como <span class="mono">02</span> se for a
                                segunda daqui. O número de páginas é estimativa — a contagem
                                exata só existe depois de compor.
                            </p>

                            @foreach (var category in resolved.Categories)
                            {
                                <div class="previa">
                                    <div class="previa__h">
                                        <span class="mono previa__n">@category.Label</span>
                                        <b>@category.Name</b>
                                        <em>@category.Products.Count</em>
                                    </div>

                                    <ul class="previa__l">
                                        @foreach (var product in category.Products)
                                        {
                                            <li class="previa__i @(product.IsNewSinceLastGeneration ? "previa__i--novo" : null)">
                                                <span>@product.Name</span>

                                                @if (product.IsNewSinceLastGeneration)
                                                {
                                                    <span class="previa__b">novo</span>
                                                }

                                                <span class="mono">@product.Price.ToString("C2", Brazil)</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private static readonly CultureInfo Brazil = CultureInfo.GetCultureInfo("pt-BR");

    private CatalogDraft draft = new();
    private ResolvedCatalog? resolved;
    private IReadOnlyList<Category>? categories;
    private CatalogFailure? failure;
    private bool notFound;
    private bool saved;

    /// <summary>
    /// `semCategoria` é o estado que a UI-08 declara para critério sem categoria marcada: com
    /// ele, salvar fica indisponível e a prévia dá lugar a orientação.
    /// </summary>
    private string StateId => (notFound, categories, draft.CategoryIds.Count) switch
    {
        (true, _, _) => "naoEncontrado",
        (_, null, _) => "carregando",
        (_, _, 0) => "semCategoria",
        _ => "default"
    };

    protected override async Task OnParametersSetAsync()
    {
        categories = await Categories.ListAsync();

        if (Id is { } id)
        {
            var found = await Maintenance.FindAsync(id);

            if (found is null)
            {
                notFound = true;
                return;
            }

            draft = found;
            await ResolveAsync();
        }
    }

    private async Task ResolveAsync()
    {
        resolved = Id is { } id ? await Resolution.ResolveAsync(id) : null;
    }

    private void Toggle(int categoryId, ChangeEventArgs change)
    {
        failure = null;
        saved = false;

        if (change.Value is true)
        {
            if (!draft.CategoryIds.Contains(categoryId))
            {
                draft.CategoryIds.Add(categoryId);
            }

            return;
        }

        draft.CategoryIds.Remove(categoryId);
    }

    private async Task SaveAsync()
    {
        saved = false;

        var outcome = await Maintenance.SaveAsync(draft);

        if (!outcome.Succeeded)
        {
            failure = outcome.Failure;
            return;
        }

        failure = null;
        saved = true;

        // A prévia é recalculada a cada mudança de critério (RN-30): o que ela mostra é
        // resolvido agora, e guardar o resultado anterior seria exibir passado.
        await ResolveAsync();

        if (Id is null)
        {
            Navigation.NavigateTo($"/painel/catalogos/{outcome.Id}");
        }
    }

    private static string MessageFor(CatalogFailure failure) => failure switch
    {
        CatalogFailure.NameRequired => "O catálogo precisa de um nome.",
        CatalogFailure.NameAlreadyInUse => "Já existe um catálogo com este nome.",
        CatalogFailure.NoCategorySelected =>
            "Selecione pelo menos uma categoria. Para abranger o acervo inteiro, marque todas.",
        CatalogFailure.NotFound => "O catálogo não existe mais.",
        _ => string.Empty
    };
}
