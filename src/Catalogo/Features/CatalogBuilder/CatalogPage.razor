@page "/painel/catalogos/novo"
@page "/painel/catalogos/{Id:int}"
@implements IDisposable
@layout PanelLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits PanelPageBase
@rendermode InteractiveServer
@using Catalogo.Features.Categories
@using Catalogo.Features.PdfExport
@using Microsoft.JSInterop
@using System.Globalization
@inject CatalogMaintenance Maintenance
@inject CatalogResolution Resolution
@inject CatalogGeneration Generation
@inject IJSRuntime Download
@inject ILogger<CatalogPage> Logger
@inject CategoryMaintenance Categories

@*
    UI-08, primeira parte: o **critério**. A prévia e a geração são T-23 e T-25, e é por isso
    que esta tela ainda não tem o lado direito que a SPEC-UI desenha.

    O que a tela declara em voz alta é o que a ADR-014 decidiu: salva-se o critério, não a
    lista. Sem essa frase, o dono supõe que o catálogo é um pacote fechado de produtos — e a
    contagem mudando entre visitas pareceria defeito.
*@

<PageTitle>@(Id is null ? "Novo catálogo" : "Catálogo")</PageTitle>

<div class="painel">
    <h1>@(Id is null ? "Novo catálogo" : "Catálogo")</h1>
    <div class="painel__sub">
        Nome e categorias. É isso que fica salvo.
    </div>

    <div class="painel__folha" data-estado="@StateId">
        @if (notFound)
        {
            <div class="nada" data-estado="naoEncontrado">
                <h2>Catálogo não encontrado</h2>
                <p>Ele pode ter sido excluído em outra aba.</p>
                <a href="/painel/catalogos">Ver todos os catálogos</a>
            </div>
        }
        else if (categories is null)
        {
            <p>Carregando…</p>
        }
        else
        {
            <div class="painel-bloco">
                <div class="painel-bloco__hd">
                    <h2>Critério</h2>
                </div>

                <div class="painel-bloco__bd produto__campos">
                    <p class="campo__ajuda">
                        O que fica salvo é <b>o critério</b>, não a lista de produtos. Gerar
                        este catálogo em outra data produz o acervo daquela data — é o que
                        evita que um catálogo envelheça sozinho.
                    </p>

                    <div class="campo">
                        <label class="campo__rotulo" for="nome">Nome</label>
                        <input id="nome" type="text" @bind="draft.Name"
                               maxlength="@Catalog.NameMaxLength"
                               placeholder="Consumíveis" />

                        @if (failure is CatalogFailure.NameRequired or CatalogFailure.NameAlreadyInUse)
                        {
                            <span class="campo__erro" role="alert">@MessageFor(failure.Value)</span>
                        }
                    </div>

                    <fieldset class="campo">
                        <legend class="campo__rotulo">Categorias</legend>

                        @if (categories.Count == 0)
                        {
                            <p class="campo__erro" role="alert">
                                Não há categorias cadastradas. Um catálogo precisa de pelo
                                menos uma — <a href="/painel/categorias">crie a primeira</a>.
                            </p>
                        }

                        @foreach (var category in categories)
                        {
                            <label class="campo__opcao">
                                <input type="checkbox"
                                       checked="@draft.CategoryIds.Contains(category.Id)"
                                       @onchange="changed => Toggle(category.Id, changed)" />
                                <span>@category.Name</span>
                            </label>
                        }

                        @* RN-28: abranger o acervo inteiro é marcar todas, não deixar nenhuma
                           marcada. A tela precisa dizer isso, senão "nenhuma" parece "todas". *@
                        <span class="campo__ajuda">
                            Marque ao menos uma. Para abranger o acervo inteiro, marque
                            todas — deixar nenhuma marcada não significa "todas".
                        </span>

                        @if (failure is CatalogFailure.NoCategorySelected)
                        {
                            <span class="campo__erro" role="alert" data-estado="semCategoria">
                                @MessageFor(failure.Value)
                            </span>
                        }
                        else if (failure is CatalogFailure.CategoryNoLongerExists
                            or CatalogFailure.ConcurrentChange)
                        {
                            @* As duas recusas de corrida entre abas nascem no critério e é aqui
                               que o dono está olhando quando elas acontecem. Sem ponto de
                               renderização, elas só teriam a saída que tinham antes: derrubar o
                               circuito. *@
                            <span class="campo__erro" role="alert">@MessageFor(failure.Value)</span>
                        }
                    </fieldset>
                </div>

                <div class="painel-bloco__ft">
                    <button type="button" class="btn btn--primario" @onclick="SaveAsync"
                            disabled="@(draft.CategoryIds.Count == 0)">
                        Salvar critério
                    </button>

                    <a class="btn btn--fantasma" href="/painel/catalogos">Voltar</a>

                    @if (saved)
                    {
                        <span class="produto__salvo" role="status" data-estado="salvo">
                            Critério salvo.
                        </span>
                    }
                </div>
            </div>

            @* RN-31: a prévia **precede a geração, sempre**. Não existe caminho que a pule, e
               é por isso que ela não é uma aba nem um modal: é o corpo da tela, ao lado do
               critério. Um botão "gerar direto" anularia a proteção que justifica a ADR-014. *@
            @if (Id is not null)
            {
                <div class="painel-bloco">
                    <div class="painel-bloco__hd">
                        <h2>Prévia do que vai sair</h2>

                        @* Cada selo tem marcador próprio. Sem eles, afirmar "4 produtos" no HTML
                           encontrava também a contagem **por categoria** mais abaixo, e apagar o
                           total e a estimativa da tela mantinha o teste verde. *@
                        @if (draft.CategoryIds.Count > 0 && resolved is { IsEmpty: false } preview)
                        {
                            <span class="selo selo--no-ar" data-previa="total">@CountLabel(preview.ProductCount)</span>
                            <span class="selo" data-previa="categorias">@CategoryLabel(preview.Categories.Count)</span>
                            <span class="selo selo--rascunho" data-previa="paginas">@PageLabel(preview.EstimatedPages)</span>
                        }
                    </div>

                    <div class="painel-bloco__bd">
                        @* A ordem dos ramos é deliberada: desmarcar a última categoria também
                           invalida `resolved`, e sem o teste de seleção vazia vir primeiro o
                           estado `semCategoria` que a UI-08 desenha seria engolido pelo convite
                           genérico a salvar. *@
                        @if (draft.CategoryIds.Count == 0)
                        {
                            @* `UI-08.semCategoria`: a prévia dá lugar à orientação, porque o que
                               ela mostraria é o critério **anterior** — e mostrar a lista antiga
                               ao lado de um critério vazio faria o dono gerar aquilo sem saber. *@
                            <p class="campo__erro" role="alert" data-estado="semCategoriaPrevia">
                                <b>Nenhuma categoria marcada.</b><br />
                                <span class="campo__ajuda">
                                    Marque ao menos uma categoria e salve o critério. Até lá não há
                                    prévia nem geração — a lista de antes não vale mais.
                                </span>
                            </p>
                        }
                        else if (resolved is null)
                        {
                            @* Duas situações chegam aqui e a frase serve às duas: o catálogo novo,
                               que ainda não tem critério gravado, e o critério alterado em tela e
                               não salvo. A prévia é sempre a do que está **gravado** — dizer isso
                               é mais honesto do que manter um retrato que discorda das caixas
                               marcadas logo acima. *@
                            <p class="campo__ajuda">Salve o critério para ver a prévia.</p>
                        }
                        else if (resolved.IsEmpty)
                        {
                            @* RN-46 / CA-18: nenhum produto No ar atende ao critério. A razão
                               precisa estar na tela — "nada aqui" sem motivo faz o dono achar
                               que o catálogo quebrou, quando o acervo é que está em Rascunho. *@
                            <p class="campo__erro" role="alert" data-estado="previaVazia">
                                <b>Nenhum produto No ar atende a este critério.</b><br />
                                <span class="campo__ajuda">
                                    A geração está indisponível. Produtos em Rascunho não saem
                                    no documento — confira a situação deles nas categorias
                                    escolhidas.
                                </span>
                            </p>
                        }
                        else
                        {
                            @* Categoria marcada que resolve vazio **não vira faixa** e não consome
                               número — se consumisse, o papel sairia com salto na numeração. O que
                               faltava era dizer isso: o dono marcou três categorias, o selo acima
                               diz duas, e ele descobria a ausência no papel, ou no cliente. É a
                               RN-46 aplicada a **uma** categoria em vez do catálogo inteiro —
                               "sumiu" sem razão na tela é lido como defeito do sistema. *@
                            @if (resolved.EmptyCategoryNames.Count > 0)
                            {
                                <p class="campo__erro" role="status" data-estado="categoriaVazia">
                                    <b>@MissingCategoriesLabel(resolved.EmptyCategoryNames)</b><br />
                                    <span class="campo__ajuda">
                                        O critério segue salvo como está. Ponha algum produto No ar
                                        nessa categoria para que ela volte à prévia — a numeração
                                        das faixas ignora quem não sai.
                                    </span>
                                </p>
                            }

                            @if (resolved.HasNewProducts)
                            {
                                @* RN-32: o destaque é a mitigação do risco central do sistema.
                                   O dono gera achando que conhece o conteúdo; sem este aviso,
                                   descobre no cliente que algo entrou. *@
                                <p class="campo__ajuda" role="status" data-estado="comItensNovos">
                                    <b>@resolved.NewSinceLastGeneration
                                    @(resolved.NewSinceLastGeneration == 1 ? "produto entrou" : "produtos entraram")
                                    neste catálogo desde a última geração.</b>
                                    Estão marcados na lista abaixo.
                                </p>
                            }

                            <p class="campo__ajuda">
                                A numeração abaixo é a <b>deste recorte</b>: uma categoria que é
                                a 6ª no cadastro sai como <span class="mono">02</span> se for a
                                segunda daqui. O número de páginas é estimativa — a contagem
                                exata só existe depois de compor.
                            </p>

                            @* RN-45: o teto é conferido **antes** de compor, e a recusa informa
                               o limite e a quantidade resolvida — "não deu" sem número deixa o
                               dono sem saber o que reduzir. *@
                            @if (resolved.ProductCount > CatalogGeneration.MaxProducts)
                            {
                                <p class="campo__erro" role="alert" data-estado="acimaDoTeto">
                                    <b>Este critério resolve @resolved.ProductCount produtos, e o
                                    limite por catálogo é @CatalogGeneration.MaxProducts.</b><br />
                                    <span class="campo__ajuda">
                                        Reduza as categorias do recorte. O limite existe porque a
                                        composição concorre com a vitrine pelo mesmo servidor.
                                    </span>
                                </p>
                            }

                            @foreach (var category in resolved.Categories)
                            {
                                <div class="previa">
                                    <div class="previa__h">
                                        <span class="mono previa__n">@category.Label</span>
                                        <b>@category.Name</b>
                                        @* A contagem por categoria diz a unidade. Um número solto
                                           ao lado do nome é lido como código, preço ou posição —
                                           e é justamente por categoria que o dono decide o que
                                           tirar do recorte quando passa do teto. *@
                                        <em data-contagem="@category.Id">@CountLabel(category.Products.Count)</em>
                                    </div>

                                    <ul class="previa__l">
                                        @foreach (var product in category.Products)
                                        {
                                            <li class="previa__i @(product.IsNewSinceLastGeneration ? "previa__i--novo" : null)">
                                                <span>@product.Name</span>

                                                @if (product.IsNewSinceLastGeneration)
                                                {
                                                    <span class="previa__b">novo</span>
                                                }

                                                <span class="mono">@product.Price.ToString("C2", Brazil)</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>
                    @* A geração nasce **abaixo** da prévia, e não ao lado nem antes: a RN-31 diz
                       que a pré-visualização precede a geração sempre, e a ordem na tela é o
                       que garante isso sem depender de disciplina. *@
                    <div class="painel-bloco__ft">
                        <button type="button" class="btn btn--primario" @onclick="GenerateAsync"
                                disabled="@(!CanGenerate)">
                            Gerar o PDF
                        </button>

                        @if (generating)
                        {
                            <span class="campo__ajuda" role="status" data-estado="gerando">
                                @stage?.Stage
                            </span>
                        }

                        @if (generated is { } file)
                        {
                            <span class="produto__salvo" role="status" data-estado="concluido">
                                Documento pronto: @file.FileName (@Size(file.Content!.Length)).
                            </span>
                        }

                        @if (refusal is { } reason)
                        {
                            <span class="campo__erro" role="alert"
                                  data-estado="@(reason == GenerationRefusal.Failed ? "erroGeracao" : "recusado")">
                                @MessageFor(reason)
                            </span>
                        }
                    </div>

                    @if (generated is not null)
                    {
                        @* RN-35: o sistema **não guarda** o arquivo. Se o dono perder o
                           download, o caminho é gerar de novo — e o documento sairá com o
                           acervo daquele momento, não com este. Avisar isso no momento da
                           entrega é a diferença entre um sistema honesto e uma surpresa. *@
                        <div class="painel-bloco__bd">
                            <p class="campo__ajuda">
                                <b>Este arquivo é o único registro deste envio.</b> O sistema não
                                guarda cópia: gerar de novo produz um documento com o acervo
                                daquele momento, que pode não ser este. Guarde o arquivo se
                                precisar do registro.
                            </p>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private static readonly CultureInfo Brazil = CultureInfo.GetCultureInfo("pt-BR");

    private CatalogDraft draft = new();
    private ResolvedCatalog? resolved;
    private IReadOnlyList<Category>? categories;
    private CatalogFailure? failure;
    private bool notFound;
    private bool saved;

    /// <summary>
    /// Cancela a geração quando o dono sai da tela. Sem isso, navegar durante a composição deixava
    /// o trabalho rodando e **o semáforo preso**: a próxima tentativa recebia "já existe uma
    /// geração em andamento" sem que houvesse ninguém esperando o resultado.
    /// </summary>
    private CancellationTokenSource? cancellation;

    private bool generating;
    private GenerationProgress? stage;
    private GenerationOutcome? generated;
    private GenerationRefusal? refusal;

    /// <summary>
    /// Limpa tudo o que foi carregado do catálogo anterior.
    ///
    /// As duas rotas são do mesmo componente, então o roteador reaproveita a instância ao passar de
    /// um catálogo para o cadastro em branco. Sem este reset, o ramo `Id is null` não limpava nada:
    /// a tela dizia "Novo catálogo" com o nome e as categorias do catálogo anterior, e **Salvar
    /// critério editaria aquele catálogo** em vez de criar outro, porque `draft.Id` sobrevivia.
    ///
    /// Hoje nenhum link produz essa transição — todos remontam o componente —, o que torna a
    /// proteção acidental. É a mesma classe de defeito que R-01 de `REVIEW-T-14-2026-09-28`
    /// encontrou em `ProductPage`, e lá ela deixou de ser acidental quando T-17 acrescentou um link.
    /// </summary>
    private void Reset()
    {
        draft = new CatalogDraft();
        resolved = null;
        notFound = false;
        saved = false;
        failure = null;
        generated = null;
        refusal = null;
        stage = null;
    }

    /// <summary>
    /// `semCategoria` é o estado que a UI-08 declara para critério sem categoria marcada: com
    /// ele, salvar fica indisponível e a prévia dá lugar a orientação.
    /// </summary>
    private string StateId => (notFound, categories, draft.CategoryIds.Count) switch
    {
        (true, _, _) => "naoEncontrado",
        (_, null, _) => "carregando",
        (_, _, 0) => "semCategoria",
        _ => "default"
    };

    protected override async Task OnParametersSetAsync()
    {
        categories = await Categories.ListAsync();

        if (Id is null)
        {
            Reset();
        }

        if (Id is { } id)
        {
            var found = await Maintenance.FindAsync(id);

            if (found is null)
            {
                notFound = true;
                return;
            }

            draft = found;
            await ResolveAsync();
        }
    }

    private async Task ResolveAsync()
    {
        resolved = Id is { } id ? await Resolution.ResolveAsync(id) : null;
    }

    /// <summary>
    /// Gerar exige prévia com conteúdo e dentro do teto. O botão desabilitado não é a única
    /// proteção — a geração confere tudo de novo no servidor, porque o critério pode ter mudado
    /// entre carregar a tela e clicar.
    /// </summary>
    private bool CanGenerate =>
        !generating

        // O critério **em tela** também conta, e não só o gravado. Desmarcar todas as categorias
        // levava a folha ao estado `semCategoria` e desabilitava Salvar, mas `resolved` continuava
        // sendo o do critério anterior: a prévia seguia listando produtos e Gerar seguia habilitado,
        // então o dono que desmarcou tudo para refazer o recorte gerava o PDF **antigo** com a tela
        // dizendo que não havia critério. O estado que a UI-08 desenhou como bloqueio era o estado
        // em que a geração continuava liberada.
        //
        // A condição que fecha o caso comum, porém, é `resolved` não ser nulo: trocar uma
        // categoria por outra mantinha a seleção não vazia e passava por aqui. Hoje `Toggle`
        // invalida a prévia, e é isso que desabilita Gerar enquanto o critério em tela discordar
        // do gravado — desmarcar todas é só o caso raro do mesmo mecanismo.
        && draft.CategoryIds.Count > 0
        && resolved is { IsEmpty: false } preview
        && preview.ProductCount <= CatalogGeneration.MaxProducts;

    private async Task GenerateAsync()
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        if (generating)
        {
            return;
        }

        generating = true;
        generated = null;
        refusal = null;
        stage = GenerationProgress.Resolving;

        try
        {
            // O progresso chega pelo circuito já existente (ADR-013): sem fila, sem worker,
            // sem tela de acompanhamento. `InvokeAsync` porque o relatório vem de outro
            // contexto de execução.
            var report = new Progress<GenerationProgress>(current =>
                InvokeAsync(() =>
                {
                    stage = current;
                    StateHasChanged();
                }));

            cancellation = new CancellationTokenSource();

            var outcome = await Generation.GenerateAsync(Id!.Value, report, cancellation.Token);

            if (!outcome.Succeeded)
            {
                refusal = outcome.Refusal;
                return;
            }

            // O arquivo vai do servidor para o navegador e **não é gravado em disco** em momento
            // nenhum (RN-35). O fluxo é lido a partir da memória e descartado quando o download
            // termina.
            using var stream = new MemoryStream(outcome.Content!);
            using var reference = new DotNetStreamReference(stream);

            await Download.InvokeVoidAsync("baixarArquivo", outcome.FileName, reference);

            // **Só agora** o documento é dado por entregue, e a data da RN-33 é registrada. Se a
            // chamada acima falhar — reconexão, aba fechada, espera esgotada — nada é marcado, e o
            // destaque da RN-32 continua comparando com a última geração que alguém recebeu.
            await Generation.ConfirmDeliveryAsync(Id!.Value, outcome);

            generated = outcome;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao gerar o catálogo {Id}.", Id);

            // `generated` é limpo: sem isso a tela mostrava "Documento pronto" e "a composição
            // falhou" ao mesmo tempo, e o dono não tinha como saber qual das duas era verdade.
            generated = null;
            refusal = GenerationRefusal.Failed;
        }
        finally
        {
            cancellation?.Dispose();
            cancellation = null;
            generating = false;

            // A data da última geração mudou: a prévia precisa refletir isso, porque o destaque
            // de itens novos é relativo a ela (RN-32).
            await ResolveAsync();
        }
    }

    /// <summary>
    /// A contagem com a unidade, em **uma** expressão. Duas expressões seguidas no Razor saem
    /// separadas por quebra de linha no HTML, e "3" numa linha com "produtos" na seguinte não é o
    /// mesmo texto para quem lê a página nem para quem a verifica.
    /// </summary>
    private static string CountLabel(int count) => $"{count} {(count == 1 ? "produto" : "produtos")}";

    /// <summary>
    /// O número de categorias do recorte. A SPEC-UI o pede ao lado do total, e ele é o que diz ao
    /// dono se o critério é o que ele acha que é.
    ///
    /// A divergência que ele revela tem **um** sentido só: a resolução parte dos produtos, então
    /// ela só devolve um subconjunto do que foi marcado. Resolver cinco quando ele marcou duas é
    /// impossível; resolver duas quando ele marcou três acontece toda vez que uma categoria está
    /// inteira em Rascunho — e é por isso que o selo sozinho não basta, e o aviso que nomeia as
    /// ausentes vem logo abaixo.
    /// </summary>
    private static string CategoryLabel(int count) =>
        $"{count} {(count == 1 ? "categoria" : "categorias")}";

    /// <summary>
    /// Nomeia as categorias que ficaram de fora. O **nome** é a informação: "uma categoria do
    /// critério está vazia" obriga o dono a conferir todas para descobrir qual, e um aviso que
    /// não poupa esse trabalho não vale o espaço que ocupa acima da prévia.
    /// </summary>
    private static string MissingCategoriesLabel(IReadOnlyList<string> names) =>
        names.Count == 1
            ? $"{names[0]} não tem nenhum produto No ar e não sai neste catálogo."
            : $"{string.Join(", ", names)} não têm nenhum produto No ar e não saem neste catálogo.";

    /// <summary>
    /// A estimativa leva o til: a contagem exata só existe depois de compor, porque célula que não
    /// cabe desce inteira para a página seguinte (RN-42).
    /// </summary>
    private static string PageLabel(int pages) =>
        $"~{pages} {(pages == 1 ? "página" : "páginas")}";

    private static string Size(int bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB"
    };

    private string MessageFor(GenerationRefusal refusal) => refusal switch
    {
        GenerationRefusal.NotFound => "O catálogo não existe mais.",
        GenerationRefusal.NoProducts =>
            "Nenhum produto No ar atende ao critério — não há o que gerar.",
        GenerationRefusal.AboveLimit =>
            $"O critério resolve {resolved?.ProductCount} produtos, acima do limite de "
            + $"{CatalogGeneration.MaxProducts}. Reduza as categorias do recorte.",
        GenerationRefusal.NoCover =>
            "Envie a capa nas Configurações antes de gerar: o documento é a capa mais as "
            + "páginas de conteúdo.",
        GenerationRefusal.AlreadyRunning =>
            "Já existe uma geração em andamento. Aguarde a conclusão e tente de novo.",
        GenerationRefusal.Failed =>
            "A composição falhou e nada foi entregue. Tente novamente.",
        _ => string.Empty
    };

    private void Toggle(int categoryId, ChangeEventArgs change)
    {
        failure = null;
        saved = false;

        // A prévia é do critério **gravado**, e mudar a marcação a deixava retratando o recorte
        // anterior: quatro caixas marcadas ao lado de uma lista de três, com Gerar habilitado
        // porque a única condição sobre a seleção em tela era haver alguma. O dono confirmava um
        // conteúdo na tela e recebia outro no PDF, sem nada estar tecnicamente errado — a única
        // forma de o aceite em papel discordar do pedido.
        //
        // Invalidar é melhor do que recalcular: resolver o que ainda não está gravado desenharia
        // uma prévia que o botão Gerar não produz, porque a geração parte do critério do banco.
        resolved = null;

        if (change.Value is true)
        {
            if (!draft.CategoryIds.Contains(categoryId))
            {
                draft.CategoryIds.Add(categoryId);
            }

            return;
        }

        draft.CategoryIds.Remove(categoryId);
    }

    private async Task SaveAsync()
    {
        if (!await SessionIsAliveAsync())
        {
            return;
        }

        saved = false;

        var outcome = await Maintenance.SaveAsync(draft);

        if (!outcome.Succeeded)
        {
            failure = outcome.Failure;

            // `NotFound` não pertence a campo nenhum — nem o nome nem as categorias estão erradas,
            // o catálogo é que deixou de existir —, e os dois pontos de erro da tela são
            // condicionados a falhas de campo. A mensagem existia e não tinha onde aparecer: o
            // clique em "Salvar critério" terminava em tela idêntica, indistinguível de um clique
            // que não registrou, e o dono clicava de novo. `naoEncontrado` é a resposta honesta —
            // a tela para de oferecer a edição de um critério que não tem mais onde ser gravado, e
            // oferece o caminho de volta.
            notFound = outcome.Failure == CatalogFailure.NotFound;

            if (outcome.Failure == CatalogFailure.CategoryNoLongerExists)
            {
                // A lista de categorias em tela é de quando ela foi carregada, e uma delas foi
                // excluída desde então. Recarregar é parte da recusa: sem isso a caixa da categoria
                // morta continua marcada e o próximo clique em Salvar recusa de novo, pelo mesmo
                // motivo, sem que nada na tela tenha mudado. A seleção é reduzida ao que sobrou
                // para que refazer o recorte parta do estado real do acervo.
                categories = await Categories.ListAsync();
                draft.CategoryIds = draft.CategoryIds
                    .Where(id => categories.Any(category => category.Id == id))
                    .ToList();
            }

            return;
        }

        failure = null;
        saved = true;

        // A prévia é recalculada a cada mudança de critério (RN-30): o que ela mostra é
        // resolvido agora, e guardar o resultado anterior seria exibir passado.
        await ResolveAsync();

        if (Id is null)
        {
            Navigation.NavigateTo($"/painel/catalogos/{outcome.Id}");
        }
    }

    public void Dispose()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    private static string MessageFor(CatalogFailure failure) => failure switch
    {
        CatalogFailure.NameRequired => "O catálogo precisa de um nome.",
        CatalogFailure.NameAlreadyInUse => "Já existe um catálogo com este nome.",
        CatalogFailure.NoCategorySelected =>
            "Selecione pelo menos uma categoria. Para abranger o acervo inteiro, marque todas.",
        CatalogFailure.NotFound => "O catálogo não existe mais.",
        CatalogFailure.CategoryNoLongerExists =>
            "Uma das categorias marcadas foi excluída em outra aba. A lista acima já está "
            + "atualizada — confira o recorte e salve de novo.",
        CatalogFailure.ConcurrentChange =>
            "Este catálogo foi alterado em outra aba enquanto você salvava. Recarregue a página "
            + "para ver o critério gravado antes de refazer a alteração.",
        _ => string.Empty
    };
}
